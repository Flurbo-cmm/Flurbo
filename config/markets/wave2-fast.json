    {
      "id": "wave2-f1", "title": "F1 Jobs Friday", "label": "Jobs Friday", "closesAt": "2026-10-02T12:00:00Z", "b": "100",
      "rules": [
        {
          "eventId": "us-unemployment-sep",
          "question": "Will the US unemployment rate for September 2026 be at least 4.2%, as published by the Bureau of Labor Statistics data API (series LNS14000000) and first captured between 12:35 and 16:30 UTC on 2 October 2026?",
          "source": { "id": "bls-lns14000000", "publisher": "U.S. Bureau of Labor Statistics", "urls": ["https://api.bls.gov/publicAPI/v1/timeseries/data/LNS14000000"], "adapter": "json-api.v1",
            "reader": { "select": "/Results/series/0/data", "aggregate": "only", "field": "/value", "filter": [{ "path": "/year", "op": "eq", "value": "2026" }, { "path": "/period", "op": "eq", "value": "M09" }],
              "checks": [{ "path": "/status", "equals": "REQUEST_SUCCEEDED" }, { "path": "/Results/series/0/seriesID", "equals": "LNS14000000" }] } },
          "observation": { "series": "LNS14000000", "period": "2026-09", "unit": "percent" },
          "decision": { "type": "number", "operator": "gte", "value": "4.2" },
          "window": { "opens": "2026-10-02T12:35:00Z", "closes": "2026-10-02T16:30:00Z" }, "expectPending": ["EXTRACTION_AMBIGUOUS_OR_MISSING"]
        },
