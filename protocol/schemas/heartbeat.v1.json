{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flurbo.singu.online/protocol/schemas/heartbeat.v1.json",
  "title": "Runtime heartbeat",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "runtimeId",
    "sdk",
    "mode",
    "state",
    "policy",
    "pending",
    "startedAt"
  ],
  "properties": {
    "runtimeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "sdk": {
      "type": "object",
      "required": [
        "language",
        "version"
      ],
      "properties": {
        "language": {
          "enum": [
            "typescript",
            "python",
            "rust",
            "cpp"
          ]
        },
        "version": {
          "type": "string",
          "maxLength": 32
        }
      }
    },
    "mode": {
      "enum": [
        "paper",
        "live"
      ]
    },
    "state": {
      "enum": [
        "running",
        "paused",
        "blocked",
        "stopping",
        "stopped"
      ]
    },
    "policy": {
      "type": "object",
      "required": [
        "hash",
        "flurboVersion"
      ],
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "SHA-256 of the canonical JSON of the effective local policy"
        },
        "flurboVersion": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Version of the Flurbo policy the runtime applies"
        },
        "summary": {
          "type": "object"
        }
      }
    },
    "pending": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "startedAt": {
      "type": "integer"
    },
    "lastCycleAt": {
      "type": [
        "integer",
        "null"
      ]
    },
    "lastErrorCode": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Za-z_]{1,48}$"
    }
  }
}
