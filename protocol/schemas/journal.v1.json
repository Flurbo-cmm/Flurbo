{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flurbo.singu.online/protocol/schemas/journal.v1.json",
  "title": "flurbo.agent-journal.v1",
  "description": "Local runtime journal. See specs/transactions.md.",
  "type": "object",
  "required": [
    "schema",
    "wallet",
    "chainId",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "flurbo.agent-journal.v1"
    },
    "wallet": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "chainId": {
      "const": 10143
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "action",
          "namespace",
          "status",
          "plannedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "action": {
            "enum": [
              "approve",
              "buy",
              "sell",
              "redeem"
            ]
          },
          "namespace": {
            "type": "string"
          },
          "claim": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "scope",
                  "mask"
                ],
                "properties": {
                  "scope": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 15
                  },
                  "mask": {
                    "type": "string",
                    "pattern": "^[1-9][0-9]{0,2}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "quantityAtoms": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,77})$"
          },
          "limitAtoms": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,77})$"
          },
          "deadline": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "enum": [
              "planned",
              "signed",
              "broadcast",
              "confirmed",
              "reverted",
              "mismatch",
              "replaced",
              "expired",
              "abandoned"
            ]
          },
          "plannedAt": {
            "type": "integer"
          },
          "nonce": {
            "type": [
              "integer",
              "null"
            ]
          },
          "rawTransaction": {
            "type": [
              "string",
              "null"
            ],
            "description": "Signed bytes, kept so recovery can resend the identical transaction"
          },
          "hash": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^0x[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "costAtoms": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,77})$"
              },
              {
                "type": "null"
              }
            ]
          },
          "decisionId": {
            "type": [
              "string",
              "null"
            ]
          },
          "report": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "pending",
                  "accepted",
                  "rejected"
                ]
              },
              "attempts": {
                "type": "integer"
              }
            }
          }
        }
      }
    }
  }
}
