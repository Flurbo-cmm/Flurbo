{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flurbo.singu.online/protocol/schemas/deployment.v1.json",
  "title": "flurbo.agent-deployment.v1",
  "type": "object",
  "required": [
    "schema",
    "interface",
    "namespace",
    "chainId",
    "pool",
    "resolver",
    "collateral",
    "codeHashes",
    "rulesHash",
    "closesAt",
    "eventCount",
    "limits"
  ],
  "properties": {
    "schema": {
      "const": "flurbo.agent-deployment.v1"
    },
    "interface": {
      "const": "flurbo.pilot-pool.v1"
    },
    "namespace": {
      "type": "string",
      "pattern": "^(pilot|practice-[0-9a-f]{40})$"
    },
    "chainId": {
      "const": 10143
    },
    "pool": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "resolver": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{40}$"
    },
    "collateral": {
      "type": "object",
      "required": [
        "address",
        "decimals"
      ],
      "properties": {
        "address": {
          "const": "0xa9012a055bd4e0edff8ce09f960291c09d5322dc"
        },
        "decimals": {
          "const": 6
        }
      }
    },
    "codeHashes": {
      "type": "object",
      "required": [
        "pool",
        "resolver"
      ],
      "properties": {
        "pool": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "resolver": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        }
      }
    },
    "rulesHash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    },
    "closesAt": {
      "type": "integer"
    },
    "eventCount": {
      "enum": [
        2,
        3,
        4
      ]
    },
    "limits": {
      "type": "object",
      "required": [
        "maxQuantityAtoms",
        "maxLimitAtoms",
        "slippageBps",
        "maxDeadlineSeconds"
      ],
      "properties": {
        "maxQuantityAtoms": {
          "const": "100000000"
        },
        "maxLimitAtoms": {
          "const": "100000000"
        },
        "slippageBps": {
          "const": [
            10,
            50,
            100
          ]
        },
        "maxDeadlineSeconds": {
          "const": 300
        }
      }
    }
  }
}
