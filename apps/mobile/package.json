    "passkeys:association": "node scripts/generate-passkey-association.cjs",
    "export:native": "expo export --platform all",
    "prebuild": "expo prebuild --no-install"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "@walletconnect/react-native-compat": "2.25.0",
    "@walletconnect/sign-client": "2.25.0",
    "expo": "~57.0.26",
    "expo-application": "57.0.3",
    "expo-clipboard": "57.0.2",
    "expo-constants": "~57.0.20",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-get-random-values": "1.11.0",
    "react-native-passkey": "3.6.1",
    "react-native-safe-area-context": "5.7.0",
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@types/react": "19.2.4",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.2",
    "typescript": "6.0.3"
  }
