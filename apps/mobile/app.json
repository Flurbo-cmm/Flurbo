{
  "expo": {
    "name": "Flurbo",
    "slug": "flurbo-mobile",
    "version": "0.3.0",
    "icon": "./assets/brand/icon.png",
    "scheme": "flurbo",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F5F3EC",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.flurbo.preview"
    },
    "android": {
      "versionCode": 5,
      "package": "dev.flurbo.preview",
      "adaptiveIcon": {
        "foregroundImage": "./assets/brand/adaptive-foreground.png",
        "monochromeImage": "./assets/brand/adaptive-monochrome.png",
        "backgroundColor": "#14271D"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/brand/splash.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#F5F3EC"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f8b90478-5afc-472b-91ca-67e5437e87e8"
      }
    },
    "owner": "singuu"
  }
}
