{
  "name": "@flurbo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server/production.mjs",
    "dev": "vite --host 127.0.0.1 --port 18767 --strictPort",
    "typecheck": "tsc --noEmit",
    "check:mock": "node scripts/check-mock-readiness.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 18767 --strictPort"
  },
  "dependencies": {
    "@category-labs/mera": "0.2.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@scure/bip32": "2.4.0",
    "@scure/bip39": "2.4.0",
    "framer-motion": "13.4.2",
    "gsap": "3.15.0",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "viem": "2.56.8",
    "wouter": "3.11.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
