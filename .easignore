# EAS archives the Git root. Include only the mobile build inputs and shared RPC config.
/*
!/apps
/apps/*
!/apps/mobile
/apps/mobile/*
!/apps/mobile/App.tsx
!/apps/mobile/index.ts
!/apps/mobile/app.json
!/apps/mobile/app.config.js
!/apps/mobile/eas.json
!/apps/mobile/package.json
!/apps/mobile/package-lock.json
!/apps/mobile/metro.config.js
!/apps/mobile/tsconfig.json
!/apps/mobile/src
!/apps/mobile/plugins
!/apps/mobile/assets
/apps/mobile/assets/*
!/apps/mobile/assets/brand
/apps/mobile/assets/brand/*
!/apps/mobile/assets/brand/*.png
!/apps/mobile/scripts
/apps/mobile/scripts/*
!/apps/mobile/scripts/passkey-config.cjs
!/config
/config/*
!/config/monad-readiness.json
!/config/learning-testnet.json

# Shared execution validators and pure helpers, not the web server or its secrets.
!/apps/web
/apps/web/*
!/apps/web/src
/apps/web/src/*
!/apps/web/src/auth
/apps/web/src/auth/*
!/apps/web/src/auth/controller.ts
!/apps/web/src/auth/policy.ts
!/apps/web/src/auth/server-session.ts
!/apps/web/src/auth/mera-provider.ts
!/apps/web/src/learning
/apps/web/src/learning/*
!/apps/web/src/learning/execution.ts
!/apps/web/src/platform-fetch.ts
!/apps/web/src/pilot.ts
!/apps/web/src/pilot-claims.ts
!/apps/web/src/portfolio.ts
!/apps/web/src/kuru.ts
!/apps/web/src/market-directory.ts
!/apps/web/src/prefetch.ts
!/apps/web/src/account-holdings.ts
!/apps/web/src/portfolio-cache.ts
!/apps/web/src/portfolio-loader.ts
!/apps/web/src/portfolio-order.ts
!/apps/web/src/portfolio-performance.ts
!/apps/web/src/portfolio-sources.ts
!/apps/web/src/wallet-links.ts
!/apps/web/shared
/apps/web/shared/*
!/apps/web/shared/pilot.mjs
!/apps/web/shared/kuru.mjs
!/apps/web/shared/learning-contracts.mjs
!/apps/web/shared/claims.mjs
!/apps/web/shared/holder-challenge.mjs
!/apps/web/server
/apps/web/server/*
!/apps/web/server/network.mjs
!/apps/web/server/withdrawal-policy.mjs
!/apps/dashboard
/apps/dashboard/*
!/apps/dashboard/claims.mjs
!/apps/dashboard/wallet.mjs
!/packages
/packages/*
!/packages/sdk
/packages/sdk/*
!/packages/sdk/package.json
!/packages/sdk/src
/packages/sdk/src/*
!/packages/sdk/src/semantics.ts
!/packages/sdk/src/request-scheduler.ts

# These exclusions also apply to any future files within included source folders.
node_modules/
.env*
credentials.json
*.jks
*.keystore
*.p8
*.p12
*.pem
*.key
*.mobileprovision
*.test.*
